<Project Sdk="Microsoft.NET.Sdk">

  <!-- 1. 全局配置与元数据 (Global Metadata) -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <TargetPlatformMinVersion>10.0.26100.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <RootNamespace>EricGameLauncher</RootNamespace>
    <AssemblyName>EricGameLauncher</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <WindowsAppSDKSelfContained Condition="'$(WindowsAppSDKSelfContained)' == ''">false</WindowsAppSDKSelfContained>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ErrorOnUnsupportedTargetingPlatformVersion>false</ErrorOnUnsupportedTargetingPlatformVersion>
    <AppxPackage>false</AppxPackage>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <WindowsAppSDKUsePrerelease>false</WindowsAppSDKUsePrerelease>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DisableEmbeddedXbf>false</DisableEmbeddedXbf>
    <GenerateLibraryLayout>true</GenerateLibraryLayout>
    <AppxGeneratePriEnabled>false</AppxGeneratePriEnabled>
    <ApplicationIcon>ico.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ReleasePackageDirectory Condition="'$(ReleasePackageDirectory)' == ''">Releasepack</ReleasePackageDirectory>

    <!-- 彻底排除源码与中间产物，防止递归扫描 -->
    <DefaultItemExcludes>
      $(DefaultItemExcludes);Components\**;output\**;Releasepack\**;Test\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 3. 构建生命周期管理：构建前阶段 (Pre-Build Context) -->
  <PropertyGroup Condition="'$(EglUiHarness)' == 'true' and '$(Configuration)' == 'Debug'">
    <StartupObject>UiHarness</StartupObject>
    <OutputType>Exe</OutputType>
    <OutputPath>$(EglUiHarnessOutput)</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>
  <ItemGroup Condition="'$(EglUiHarness)' == 'true' and '$(Configuration)' == 'Debug'">
    <Compile Include="Test\UiHarness.cs;Test\Regression\UiFeatures.cs" />
  </ItemGroup>

  <!-- 强制预编译并发布 MainUpdater 影子组件 -->
  <ItemGroup>
    <_MainUpdaterSource Include="Components\updater.main\*.cs;Components\updater.main\*.csproj;Core\UpdatePackageIntegrity.cs;Core\UpdateDownload.cs;Core\InstallRegistration.cs" />
    <_CfgUpdaterSource Include="Components\updater.cfgver\*.cs;Components\updater.cfgver\*.csproj;Components\updater.cfgver\*.yaml" />
  </ItemGroup>
  <Target Name="BuildMainUpdater" BeforeTargets="BeforeBuild" Inputs="@(_MainUpdaterSource);Directory.Build.props;Version.cs" Outputs="Components\updater.main\bin\$(Configuration)\net10.0\win-x64\publish\updater.main.dll;Components\updater.main\bin\$(Configuration)\net10.0\win-x64\publish\updater.main.runtimeconfig.json;Components\updater.main\bin\$(Configuration)\net10.0\win-x64\publish\updater.main.exe;Components\updater.main\bin\$(Configuration)\net10.0\win-x64\publish\updater.main.deps.json;Components\updater.main\bin\$(Configuration)\net10.0\win-x64\publish\YamlDotNet.dll">
    <Message Importance="High" Text="Publishing MainUpdater ($(Configuration)) to intermediate directory..." />
    <MSBuild Projects="Components\updater.main\updater.main.csproj" Targets="Restore;Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishSingleFile=false;NuGetAudit=$(NuGetAudit)" />
  </Target>

  <!-- 强制预编译并发布 CfgUpdater 影子组件 -->
  <Target Name="BuildCfgUpdater" BeforeTargets="BeforeBuild" Inputs="@(_CfgUpdaterSource);Directory.Build.props;Version.cs" Outputs="Components\updater.cfgver\bin\$(Configuration)\net10.0\win-x64\publish\updater.cfgver.dll;Components\updater.cfgver\bin\$(Configuration)\net10.0\win-x64\publish\updater.cfgver.runtimeconfig.json;Components\updater.cfgver\bin\$(Configuration)\net10.0\win-x64\publish\updater.cfgver.exe;Components\updater.cfgver\bin\$(Configuration)\net10.0\win-x64\publish\updater.cfgver.deps.json;Components\updater.cfgver\bin\$(Configuration)\net10.0\win-x64\publish\YamlDotNet.dll">
    <Message Importance="High" Text="Publishing CfgUpdater ($(Configuration)) to intermediate directory..." />
    <MSBuild Projects="Components\updater.cfgver\updater.cfgver.csproj" Targets="Restore;Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;PublishSingleFile=false;NuGetAudit=$(NuGetAudit)" />
  </Target>

  <!-- 强制编译 CLI 组件并复制到输出目录 -->
  <Target Name="BuildCli" AfterTargets="Build">
    <PropertyGroup>
      <_CliMainDll>$([System.IO.Path]::GetFullPath('$(OutputPath)'))EricGameLauncher.dll</_CliMainDll>
    </PropertyGroup>
    <Message Importance="High" Text="Building CLI ($(Configuration)) mainDll=$(_CliMainDll)..." />
    <MSBuild Projects="Components\main.cli\cli.csproj" Targets="Restore;Build" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=false;MainDllPath=$(_CliMainDll);NuGetAudit=$(NuGetAudit)" />
    <ItemGroup>
      <_CliOutput Include="Components\main.cli\bin\$(Configuration)\net10.0-windows10.0.26100\win-x64\EricGameLauncher.Cli.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CliOutput)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="Components\main.cli\bin\$(Configuration)\net10.0-windows10.0.26100\win-x64\SKILL.md" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <Message Importance="High" Text="CLI built and copied to output directory." />
  </Target>

  <!-- 4. 构建生命周期管理：构建后阶段 (Post-Build & Cleanup) -->

  <!-- 任何模式下的构建后即时清理 -->
  <Target Name="PostBuildCleanupPayload" AfterTargets="Build">
    <RemoveDir Directories="payload" />
    <Message Importance="High" Text="Post-build cleanup: payload directory removed." />
  </Target>

  <!-- Release 自动化打包流 -->
  <Target Name="BuildReleaseInstaller" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="pwsh.exe -NoProfile -NonInteractive -File &quot;$(EglRepositoryRoot).github\scripts\build-native-setup.ps1&quot; -Version &quot;$(ExtractedVersion)&quot;" />
  </Target>
  <Target Name="ZipReleaseBuild" AfterTargets="Build" DependsOnTargets="EmbedHostConfiguration;ValidateLauncherPackage;BuildReleaseInstaller" Condition="'$(Configuration)' == 'Release'">
    <Message Importance="High" Text="Zipping Release artifacts to $(ReleasePackageFileName)..." />
    <MakeDir Directories="$(ReleasePackageDirectory)" />
    <ZipDirectory SourceDirectory="$(OutputPath)" DestinationFile="$(ReleasePackageDirectory)\$(ReleasePackageFileName)" Overwrite="true" />
    <Exec Command="pwsh.exe -NoProfile -NonInteractive -File &quot;$(EglRepositoryRoot).github\scripts\package-installer.ps1&quot; -PackagePath &quot;$([System.IO.Path]::GetFullPath('$(ReleasePackageDirectory)\$(ReleasePackageFileName)'))&quot; -InstallerStub &quot;$(EglRepositoryRoot)Components\setup\bin\native\EricGameLauncher.Setup.exe&quot; -DestinationPath &quot;$([System.IO.Path]::GetFullPath('$(ReleasePackageDirectory)\$(ReleaseInstallerFileName)'))&quot;" />
  </Target>

  <!-- 6. 依赖与资源管理 (Dependencies & Resources) -->

  <ItemGroup>
    <Compile Include="Test\ProductionAccess.cs" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="1.8.251222000" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="1.8.260101001" />
    <PackageReference Include="TinyPinyin.Net" Version="1.0.2" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ico.ico" />
    <EmbeddedResource Include="text.yaml" />
    <EmbeddedResource Include="Components\main.cli\CliSkill.embed.md" LogicalName="EricGameLauncher.CliSkill.md" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="readme_res\**" />
    <Compile Remove="readme_res\**" />
    <EmbeddedResource Remove="readme_res\**" />
  </ItemGroup>

  <!-- 防止 SDK 自动通配将 payload 纳入 Content/None (求值时 payload 可能不存在，但保留声明以覆盖自动发现) -->
  <ItemGroup>
    <None Remove="payload\updater.main\**" />
    <Content Remove="payload\updater.main\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="payload\updater.cfgver\**" />
    <Content Remove="payload\updater.cfgver\**" />
  </ItemGroup>

  <!-- 动态嵌入 payload 资源：BuildMainUpdater(BeforeTargets=BeforeBuild) 早于 AssignTargetPaths -->
  <Target Name="EmbedPayloadResources" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <_PayloadMain Include="Components\updater.main\bin\$(Configuration)\net10.0\win-x64\publish\*.*" />
      <_PayloadCfg Include="Components\updater.cfgver\bin\$(Configuration)\net10.0\win-x64\publish\*.*" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Include="@(_PayloadMain)" LogicalName="EricGameLauncher.updater.main.%(Filename)%(Extension)" />
      <EmbeddedResource Include="@(_PayloadCfg)" LogicalName="EricGameLauncher.updater.cfgver.%(Filename)%(Extension)" />
    </ItemGroup>
    <Message Importance="High" Text="Dynamically embedded @(EmbeddedResource->Count()) payload resources for MainUpdater/CfgUpdater." />
  </Target>

  <Import Project="Test\Test.targets" />
  <ItemGroup>
    <_LauncherComponent Include="$(EglRepositoryRoot)Components\**\*.csproj" Exclude="$(EglRepositoryRoot)Components\**\bin\**;$(EglRepositoryRoot)Components\**\obj\**" />
    <_LauncherTest Include="$(EglRepositoryRoot)Test\**\*.csproj" Exclude="$(EglRepositoryRoot)Test\artifacts\**;$(EglRepositoryRoot)Test\**\bin\**;$(EglRepositoryRoot)Test\**\obj\**" />
  </ItemGroup>
  <Target Name="GenerateLauncherManifest" Inputs="$(EglRepositoryRoot)app.manifest;$(EglRepositoryRoot)Version.cs;$(EglRepositoryRoot)Directory.Build.props;$(MSBuildThisFileFullPath)" Outputs="$(IntermediateOutputPath)app.manifest">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Copy SourceFiles="$(EglRepositoryRoot)app.manifest" DestinationFiles="$(IntermediateOutputPath)app.manifest" />
    <XmlPoke XmlInputPath="$(IntermediateOutputPath)app.manifest" Query="/*[local-name()='assembly']/*[local-name()='assemblyIdentity']/@version" Value="$(AssemblyVersion)" />
  </Target>
  <Target Name="SetLauncherManifest" BeforeTargets="PrepareForBuild" DependsOnTargets="GenerateLauncherManifest">
    <PropertyGroup>
      <ApplicationManifest>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)app.manifest'))</ApplicationManifest>
    </PropertyGroup>
  </Target>
  <Target Name="StripLauncherDebugSymbols" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_LauncherDebugSymbols Include="$(OutputPath)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(_LauncherDebugSymbols)" />
  </Target>
  <Target Name="UseIntermediatePublishDirectoryForLibraryLayout" BeforeTargets="PrepareForPublish" Condition="'$(_IsPublishing)' != 'true'">
    <PropertyGroup>
      <PublishDir>$(IntermediateOutputPath)publish\</PublishDir>
    </PropertyGroup>
  </Target>
  <Target Name="ExcludeSourceXamlFromResourceLayout" AfterTargets="GetPackagingOutputs" DependsOnTargets="_CalculateXbfSupport">
    <ItemGroup>
      <PackagingOutputs Remove="@(PackagingOutputs)" Condition="'%(PackagingOutputs.Extension)' == '.xaml'" />
    </ItemGroup>
  </Target>
  <Target Name="ExcludeEmbeddedXamlFromOutput" AfterTargets="GetCopyToOutputDirectoryItems" BeforeTargets="_CopyOutOfDateSourceItemsToOutputDirectory;_CopyOutOfDateSourceItemsToOutputDirectoryAlways;_CopyDifferingSourceItemsToOutputDirectory" DependsOnTargets="_CalculateXbfSupport">
    <ItemGroup>
      <_SourceItemsToCopyToOutputDirectory Remove="@(_SourceItemsToCopyToOutputDirectory)" Condition="'%(_SourceItemsToCopyToOutputDirectory.Extension)' == '.xbf' Or '%(_SourceItemsToCopyToOutputDirectory.Extension)' == '.xaml'" />
      <_SourceItemsToCopyToOutputDirectoryAlways Remove="@(_SourceItemsToCopyToOutputDirectoryAlways)" Condition="'%(_SourceItemsToCopyToOutputDirectoryAlways.Extension)' == '.xbf' Or '%(_SourceItemsToCopyToOutputDirectoryAlways.Extension)' == '.xaml'" />
      <_SourceItemsToCopyToOutputDirectoryIfDifferent Remove="@(_SourceItemsToCopyToOutputDirectoryIfDifferent)" Condition="'%(_SourceItemsToCopyToOutputDirectoryIfDifferent.Extension)' == '.xbf' Or '%(_SourceItemsToCopyToOutputDirectoryIfDifferent.Extension)' == '.xaml'" />
      <AllItemsFullPathWithTargetPath Remove="@(AllItemsFullPathWithTargetPath)" Condition="'%(AllItemsFullPathWithTargetPath.Extension)' == '.xbf' Or '%(AllItemsFullPathWithTargetPath.Extension)' == '.xaml'" />
    </ItemGroup>
  </Target>
  <Target Name="EmbedCompiledXamlResources" AfterTargets="MarkupCompilePass2">
    <PropertyGroup>
      <_XamlResourceRoot>$([System.IO.Path]::GetFullPath('$(XamlGeneratedOutputPath)'))</_XamlResourceRoot>
    </PropertyGroup>
    <ItemGroup>
      <_AssemblyXbf Include="@(_GeneratedXbfFiles->Distinct())" />
      <EmbeddedResource Include="@(_AssemblyXbf)">
        <LogicalName>EricGameLauncher.Xaml.$([System.IO.Path]::GetRelativePath('$(_XamlResourceRoot)', '%(_AssemblyXbf.FullPath)').Replace('\', '.').Replace('/', '.'))</LogicalName>
        <WithCulture>false</WithCulture>
      </EmbeddedResource>
    </ItemGroup>
    <Error Condition="'@(_AssemblyXbf)' == ''" Text="No compiled XAML resources were produced." />
  </Target>
  <Target Name="ValidateLauncherPackage" DependsOnTargets="StripLauncherDebugSymbols" Condition="'$(Configuration)' == 'Release'">
    <Exec Command="pwsh.exe -NoProfile -NonInteractive -File &quot;$(EglRepositoryRoot).github\scripts\validate-package.ps1&quot; -DirectoryPath &quot;$([System.IO.Path]::GetFullPath('$(OutputPath).'))&quot;" />
  </Target>
  <Target Name="CleanLauncherIntermediate">
    <ItemGroup>
      <_LauncherClean Include="$(EglRepositoryRoot)bin;$(EglRepositoryRoot)obj;$(EglRepositoryRoot)payload;$(EglRepositoryRoot)Components\setup\bin;$(EglRepositoryRoot)Components\setup\obj;$(EglRepositoryRoot)Components\setup.core\bin;$(EglRepositoryRoot)Components\setup.core\obj;$(EglRepositoryRoot)Components\setup.uninstall\bin;$(EglRepositoryRoot)Components\setup.uninstall\obj;@(_LauncherComponent->'%(RootDir)%(Directory)bin');@(_LauncherComponent->'%(RootDir)%(Directory)obj')" />
      <_LauncherCleanTest Include="@(_LauncherTest)" Condition="'$(TestHostRunning)' != 'true' Or !$([System.String]::Copy('%(_LauncherTest.Filename)').EndsWith('.Tests'))" />
      <_LauncherClean Include="@(_LauncherCleanTest->'%(RootDir)%(Directory)bin');@(_LauncherCleanTest->'%(RootDir)%(Directory)obj')" />
    </ItemGroup>
    <Error Condition="!$([System.IO.Path]::GetFullPath('%(_LauncherClean.Identity)').StartsWith('$(EglRepositoryRoot)'))" Text="Cleanup target escaped repository: %(_LauncherClean.Identity)" />
    <RemoveDir Directories="@(_LauncherClean)" />
  </Target>
  <Target Name="CleanAfterLauncherRelease" AfterTargets="ZipReleaseBuild" DependsOnTargets="CleanLauncherIntermediate" Condition="'$(Configuration)' == 'Release'" />
  <Target Name="CleanAfterLauncherClean" AfterTargets="Clean" DependsOnTargets="CleanLauncherIntermediate" />
</Project>
