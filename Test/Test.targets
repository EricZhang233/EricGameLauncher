<Project>
  <PropertyGroup>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>
  <Target Name="RunLauncherTests" BeforeTargets="VSTest">
    <Exec Command="pwsh.exe -NoProfile -NonInteractive -File &quot;$(MSBuildThisFileDirectory)Scripts\RunTests.ps1&quot;" WorkingDirectory="$(MSBuildThisFileDirectory).." />
  </Target>
</Project>
