<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EricGameLauncher</RootNamespace>
    <AssemblyName>EricGameLauncher.Cli</AssemblyName>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="EricGameLauncher" Condition="'$(MainDllPath)' != ''">
      <HintPath>$(MainDllPath)</HintPath>
    </Reference>
    <ProjectReference Include="..\..\EricGameLauncher.csproj" Condition="'$(MainDllPath)' == ''" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="SKILL.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
