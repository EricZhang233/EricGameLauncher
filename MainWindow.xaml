                                <MenuFlyoutItem Text="" Click="MenuProp_Click" Tag="{Binding}" Icon="Edit"/>
                                <MenuFlyoutItem Text="" Click="MenuDel_Click" Tag="{Binding}" Icon="Delete" Foreground="Red"/>
