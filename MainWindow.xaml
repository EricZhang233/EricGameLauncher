<Window
    x:Class="EricGameLauncher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EricGameLauncher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <local:MainView x:Name="Main"/>

        <Grid x:Name="StartupOverlay"
              Canvas.ZIndex="3000"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              IsHitTestVisible="True"
              Loaded="StartupOverlay_Loaded">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                <Image x:Name="StartupOverlayIcon"
                       Width="88"
                       Height="88"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"/>
                <TextBlock Text="EricGameLauncher"
                           HorizontalAlignment="Center"
                           FontSize="24"
                           FontWeight="SemiBold"/>
                <ProgressRing IsActive="True"
                              Width="24"
                              Height="24"
                              HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
