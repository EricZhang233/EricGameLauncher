                                                Icon="Repair"
                                                Visibility="{Binding HasManagerOrDefault, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="" Click="MenuLoc_Click" Tag="{Binding}" Icon="Folder"/>
