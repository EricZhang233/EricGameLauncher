                            <Border x:Name="IconImgBorder" CornerRadius="21" Margin="6">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding IconPath, Converter={StaticResource ImagePathConverter}, TargetNullValue={x:Null}}" 
