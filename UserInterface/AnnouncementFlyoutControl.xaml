<UserControl
    x:Class="EricGameLauncher.AnnouncementFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EricGameLauncher">
    <Button x:Name="AnnouncementButton" ToolTipService.ToolTip="" Style="{StaticResource TitleBarButtonStyle}">
        <FontIcon x:Name="AnnouncementButtonIcon" Glyph="&#xE789;" FontSize="16"/>
        <Button.Flyout>
            <Flyout x:Name="AnnouncementFlyout" Placement="BottomEdgeAlignedRight" Opened="AnnouncementFlyout_Opened">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <StackPanel Width="380" Spacing="8" Padding="12">
                    <TextBlock x:Name="AnnouncementsTitleText" Text="" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AnnouncementsEmptyText" Text="" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" Visibility="Collapsed"/>
                    <ListView x:Name="AnnouncementsListView" MaxHeight="420" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AnnouncementsListView_ItemClick" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,4"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="CornerRadius" Value="6"/>
                                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AnnouncementListItem">
                                <StackPanel Padding="10" Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="{Binding TitleWeight}" TextWrapping="Wrap" MaxLines="{Binding TitleMaxLines}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TimeText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{ThemeResource CaptionTextBlockStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Width="16" Spacing="4">
                                            <Grid Width="16" Height="16" Visibility="{Binding HasMarker, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <FontIcon Glyph="{Binding MarkerGlyph}" FontSize="12" IsTextScaleFactorEnabled="False"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            </Grid>
                                            <Grid Width="16" Height="16" Visibility="{Binding IsUnread, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Ellipse Width="8" Height="8" Fill="Red" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                    <RichTextBlock Loaded="BodyRichText_Loaded" TextWrapping="Wrap" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisibilityConverter}}" Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
