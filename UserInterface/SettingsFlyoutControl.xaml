<UserControl
    x:Class="EricGameLauncher.SettingsFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="SettingsButton" Visibility="Collapsed">
        <Button.Flyout>
            <Flyout x:Name="SettingsFlyout" Placement="Bottom">
                <StackPanel Spacing="8" Width="300">
                    <TextBlock x:Name="SettingsTitle" Text="" FontSize="20" FontWeight="SemiBold"/>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SettingsGeneralLabel" Text="" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B0;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsLaunchModeLabel" Grid.Column="2" Text=""
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ComboLaunchMode" Grid.Column="3"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="ComboLaunchMode_SelectionChanged"/>
                        </Grid>
                        <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8BB;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsCloseAfterLaunchLabel" Text="" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ToggleCloseAfterLaunch" Grid.Column="2"
                                          OffContent="" OnContent="" MinWidth="0"
                                          VerticalAlignment="Center" Margin="0,-8,0,-8"
                                          Toggled="ToggleCloseAfterLaunch_Toggled"/>
                        </Grid>
                        <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE895;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsUpdateChannelLabel" Grid.Column="2" Text=""
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ComboUpdateChannel" Grid.Column="3"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="ComboUpdateChannel_SelectionChanged"/>
                        </Grid>
                        <TextBlock x:Name="SettingsUpdateChannelDesc" Text=""
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                        <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Grid ColumnDefinitions="Auto,*">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsGitHubTokenLabel" Text="" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="GitHubTokenViewRow" ColumnDefinitions="Auto,*,Auto">
                            <TextBlock x:Name="GitHubTokenStatusText" Grid.Column="0" Text=""
                                       VerticalAlignment="Center" FontSize="13"/>
                            <Button x:Name="GitHubTokenEditBtn" Grid.Column="2" Content=""
                                    Click="GitHubTokenEditBtn_Click" Padding="8,4" ToolTipService.ToolTip=""/>
                        </Grid>
                        <Grid x:Name="GitHubTokenEditRow" ColumnDefinitions="*,Auto,Auto" Visibility="Collapsed">
                            <TextBox x:Name="GitHubTokenBox" Grid.Column="0" PlaceholderText=""
                                     HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                            <Button x:Name="GitHubTokenSaveBtn" Grid.Column="1" Content=""
                                    Click="GitHubTokenSaveBtn_Click" Padding="8,4" Margin="0,0,4,0"
                                    ToolTipService.ToolTip=""/>
                            <Button x:Name="GitHubTokenCancelBtn" Grid.Column="2" Content=""
                                    Click="GitHubTokenCancelBtn_Click" Padding="8,4" ToolTipService.ToolTip=""/>
                        </Grid>
                        <TextBlock x:Name="SettingsGitHubTokenDesc" Text=""
                                   Style="{ThemeResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                        <HyperlinkButton x:Name="SettingsGitHubTokenLink" Content=""
                                         NavigateUri="https://github.com/settings/personal-access-tokens"
                                         HorizontalAlignment="Left" Padding="0" FontSize="12"/>
                    </StackPanel>
                    <Border Height="2" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,4"/>
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SettingsDataLocationLabel" Text="" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="StorageModeText" Grid.Column="0" Text=""
                                       VerticalAlignment="Center" FontWeight="SemiBold" ToolTipService.ToolTip=""/>
                            <Button x:Name="BtnSwitchStorageMode" Grid.Column="2"
                                    Click="BtnSwitchStorageMode_Click" Padding="8,4" ToolTipService.ToolTip="">
                                <FontIcon Glyph="&#xE8AB;" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnOpenConfigFolder" Grid.Column="4"
                                    Click="BtnOpenFolder_Click" Padding="8,4" ToolTipService.ToolTip="">
                                <FontIcon Glyph="&#xE8DA;" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnOpenCacheFolder" Grid.Column="6"
                                    Click="BtnOpenCacheFolder_Click" Padding="8,4" ToolTipService.ToolTip="">
                                <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="SettingsMigrateNote" Text=""
                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
