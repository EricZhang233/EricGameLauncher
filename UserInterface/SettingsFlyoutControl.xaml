<UserControl
    x:Class="EricGameLauncher.SettingsFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="SettingsToggleSwitchStyle" TargetType="ToggleSwitch"
               BasedOn="{StaticResource DefaultToggleSwitchStyle}">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Margin" Value="0,-8,-12,-8"/>
        </Style>
    </UserControl.Resources>
    <Button x:Name="SettingsButton" Visibility="Collapsed">
        <Button.Flyout>
            <Flyout x:Name="SettingsFlyout" Placement="Bottom">
                <StackPanel Spacing="8" Width="300">
                    <TextBlock x:Name="SettingsTitle" Text="" FontSize="20" FontWeight="SemiBold"/>
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE945;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsQuickStartLabel" Text="" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="QuickStartHelpButton" Grid.Column="1" Click="HelpButton_Click"
                                    Padding="4,2" MinWidth="0" Background="Transparent"
                                    BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                                <FontIcon Glyph="&#xE897;" FontSize="12" Opacity="0.7"/>
                            </Button>
                            <ToggleSwitch x:Name="ToggleQuickStart" Grid.Column="2"
                                          Style="{StaticResource SettingsToggleSwitchStyle}"
                                          OffContent="" OnContent=""
                                          VerticalAlignment="Center"
                                          Toggled="ToggleQuickStart_Toggled"/>
                        </Grid>
                        <Grid x:Name="SplashAnimationPanel" ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                              Margin="28,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="SettingsSplashAnimationLabel" Text="" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsSplashFadeInLabel" Grid.Column="1" Text=""
                                       VerticalAlignment="Center" Margin="10,0,2,0"/>
                            <ToggleSwitch x:Name="ToggleSplashFadeIn" Grid.Column="2"
                                          Style="{StaticResource SettingsToggleSwitchStyle}"
                                          OffContent="" OnContent=""
                                          VerticalAlignment="Center"
                                          Toggled="ToggleSplashFadeIn_Toggled"/>
                            <TextBlock x:Name="SettingsSplashFadeOutLabel" Grid.Column="3" Text=""
                                       VerticalAlignment="Center" Margin="10,0,2,0"/>
                            <ToggleSwitch x:Name="ToggleSplashFadeOut" Grid.Column="4"
                                          Style="{StaticResource SettingsToggleSwitchStyle}"
                                          OffContent="" OnContent=""
                                          VerticalAlignment="Center"
                                          Toggled="ToggleSplashFadeOut_Toggled"/>
                        </Grid>
                        <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE8B0;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsLaunchModeLabel" Grid.Column="2" Text=""
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="ComboLaunchMode" Grid.Column="3"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="ComboLaunchMode_SelectionChanged"/>
                        </Grid>
                        <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8BB;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsCloseAfterLaunchLabel" Text="" VerticalAlignment="Center"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ToggleCloseAfterLaunch" Grid.Column="2"
                                          Style="{StaticResource SettingsToggleSwitchStyle}"
                                          OffContent="" OnContent=""
                                          VerticalAlignment="Center"
                                          Toggled="ToggleCloseAfterLaunch_Toggled"/>
                        </Grid>
                        <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE895;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsUpdateChannelLabel" Grid.Column="2" Text=""
                                       VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button x:Name="UpdateChannelHelpButton" Grid.Column="3" Click="HelpButton_Click"
                                    Padding="4,2" MinWidth="0" Background="Transparent"
                                    BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    CornerRadius="4"
                                    VerticalAlignment="Center" Margin="0,0,8,0">
                                <FontIcon Glyph="&#xE897;" FontSize="12" Opacity="0.7"/>
                            </Button>
                            <ComboBox x:Name="ComboUpdateChannel" Grid.Column="4"
                                      HorizontalAlignment="Stretch"
                                      SelectionChanged="ComboUpdateChannel_SelectionChanged"/>
                        </Grid>
                        <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE72E;" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SettingsGitHubTokenLabel" Text="" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button x:Name="GitHubTokenHelpButton" Grid.Column="1" Click="HelpButton_Click"
                                    Padding="4,2" MinWidth="0" Background="Transparent"
                                    BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                                <FontIcon Glyph="&#xE897;" FontSize="12" Opacity="0.7"/>
                            </Button>
                            <TextBlock x:Name="GitHubTokenStatusText" Grid.Column="2" Text=""
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="SettingsGitHubTokenLink"
                                        Click="GitHubTokenLink_Click" Padding="8,4"
                                        ToolTipService.ToolTip="">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="12"/>
                                </Button>
                                <Button x:Name="GitHubTokenEditBtn"
                                        Click="GitHubTokenEditBtn_Click" Padding="8,4" ToolTipService.ToolTip="">
                                    <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="GitHubTokenEditRow" ColumnDefinitions="*,Auto,Auto" Visibility="Collapsed">
                            <TextBox x:Name="GitHubTokenBox" Grid.Column="0" PlaceholderText=""
                                     HorizontalAlignment="Stretch" Margin="0,0,8,0"/>
                            <Button x:Name="GitHubTokenSaveBtn" Grid.Column="1" Content=""
                                    Click="GitHubTokenSaveBtn_Click" Padding="8,4" Margin="0,0,4,0"
                                    ToolTipService.ToolTip=""/>
                            <Button x:Name="GitHubTokenCancelBtn" Grid.Column="2" Content=""
                                    Click="GitHubTokenCancelBtn_Click" Padding="8,4" ToolTipService.ToolTip=""/>
                        </Grid>
                    </StackPanel>
                    <Border Height="1" Margin="0,4,0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE74E;" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SettingsDataLocationLabel" Text="" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="StorageLocationHelpButton" Grid.Column="1" Click="HelpButton_Click"
                                Padding="4,2" MinWidth="0" Background="Transparent"
                                BorderThickness="1" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                CornerRadius="4"
                                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0,0,0">
                            <FontIcon Glyph="&#xE897;" FontSize="12" Opacity="0.7"/>
                        </Button>
                        <TextBlock x:Name="StorageModeText" Grid.Column="2" Text=""
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" ToolTipService.ToolTip=""/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="BtnSwitchStorageMode"
                                    Click="BtnSwitchStorageMode_Click" Padding="8,4" ToolTipService.ToolTip="">
                                <FontIcon Glyph="&#xE8AB;" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnOpenConfigFolder"
                                    Click="BtnOpenFolder_Click" Padding="8,4" ToolTipService.ToolTip="">
                                <FontIcon Glyph="&#xE8DA;" FontSize="12"/>
                            </Button>
                            <Button x:Name="BtnOpenCacheFolder"
                                    Click="BtnOpenCacheFolder_Click" Padding="8,4" ToolTipService.ToolTip="">
                                <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
