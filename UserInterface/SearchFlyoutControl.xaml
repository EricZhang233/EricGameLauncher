<UserControl
    x:Class="EricGameLauncher.SearchFlyoutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Button x:Name="SearchButton" ToolTipService.ToolTip="" CornerRadius="4">
        <FontIcon Glyph="&#xE721;"/>
        <Button.Flyout>
            <Flyout x:Name="SearchFlyout" Placement="BottomEdgeAlignedRight" Opened="SearchFlyout_Opened" Closing="SearchFlyout_Closing">
                <AutoSuggestBox x:Name="SearchBox" QueryIcon="Find" PlaceholderText="" Width="280" TextChanged="SearchBox_TextChanged"/>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
