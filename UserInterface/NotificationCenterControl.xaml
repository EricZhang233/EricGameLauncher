<UserControl
    x:Class="EricGameLauncher.NotificationCenterControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:EricGameLauncher">

    <UserControl.Resources>
        <DataTemplate x:Key="NotificationCardTemplate" x:DataType="local:NotificationMessage">
            <Border Width="360"
                    Margin="0,6,0,0"
                    Padding="12,9"
                    CornerRadius="8"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Loaded="NotificationCard_Loaded">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Grid.Column="0"
                              Glyph="{x:Bind Glyph}"
                              FontSize="13"
                              Foreground="{x:Bind Accent}"
                              VerticalAlignment="Top"
                              Margin="0,2,0,0"/>
                    <TextBlock Grid.Column="1"
                               Margin="8,0,8,0"
                               FontSize="12"
                               VerticalAlignment="Top"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="{x:Bind FullText}"
                               TextWrapping="{x:Bind TextWrapping, Mode=OneWay}"
                               TextTrimming="{x:Bind TextTrimming, Mode=OneWay}"
                               IsTextSelectionEnabled="True"/>
                    <Button Grid.Column="2"
                            Width="30"
                            Height="30"
                            Margin="-8,-4,0,-4"
                            Padding="8,0,0,0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Top"
                            Click="ExpandButton_Click">
                        <FontIcon Glyph="{x:Bind ExpandGlyph, Mode=OneWay}" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                    <Button Grid.Column="3"
                            Width="30"
                            Height="30"
                            Margin="0,-4,-8,-4"
                            Padding="0,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            VerticalAlignment="Top"
                            Click="DismissButton_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="8" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ItemsControl x:Name="ToastHost"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  ItemTemplate="{StaticResource NotificationCardTemplate}"/>
</UserControl>
